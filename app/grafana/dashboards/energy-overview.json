          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-energy"
          },
          "query": "SELECT sum(\"total\") AS \"Generation\" FROM \"energy_series\" WHERE $timeFilter AND \"direction\" = 'DELIVERY' GROUP BY time(15m) fill(null)",
