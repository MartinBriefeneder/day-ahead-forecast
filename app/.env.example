# Copy this file to .env for local or remote server runs.
# The scripts load app/.env automatically.

INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=local-influxdb-password
INFLUXDB_ORG=kirchdorf
INFLUXDB_BUCKET=energy

# Use a long random token on shared or remote machines.
# This value must match the token used when the InfluxDB volume is first initialized.
INFLUXDB_TOKEN=replace-with-a-long-random-token

# Forecast workflow defaults.
# Set to 0 to fail when InfluxDB has no imported energy_values rows.
FORECAST_AUTO_IMPORT=1

# Override when CSV files are not in the default app/quarkus/data/csv_Archiv directory.
# ENERGY_IMPORT_DIRECTORY=./quarkus/data/csv_Archiv
